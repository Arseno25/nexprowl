# Go tooling (gofmt, go vet) treats CRLF as a formatting error, so keep every
# text file in the repository LF-normalised regardless of contributor platform.
* text=auto eol=lf

*.go        text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
go.mod      text eol=lf
go.sum      text eol=lf
Dockerfile  text eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
